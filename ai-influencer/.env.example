# 楽天(必須): https://webservice.rakuten.co.jp/ でアプリID発行
RAKUTEN_APP_ID=
# 楽天アフィリエイトID: https://affiliate.rakuten.co.jp/
RAKUTEN_AFFILIATE_ID=

# Anthropic(推奨): 未設定時はテンプレート生成にフォールバック
ANTHROPIC_API_KEY=

# X自動投稿(任意): https://developer.x.com/
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# 実投稿するには true にする(既定はドライラン)
X_POST_ENABLED=false

# true にするとAPIを一切呼ばずサンプルデータで動作確認できる
DRY_RUN=false
